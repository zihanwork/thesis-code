{
  "name": "eai_balanced_multimodel",
  "continue_on_error": true,
  "base_experiment": {
    "name": "eai_balanced_multimodel",
    "tasks_path": "data/processed/tasksets/balanced_eval.jsonl",
    "retrieval_examples_path": "data/processed/tasksets/rag_train.jsonl",
    "output_dir": "runs/eai_balanced_multimodel",
    "planners": [
      "P0_prompt_only",
      "P1_retrieval_augmented",
      "P2_graph_grounded"
    ],
    "harness_modes": [
      "H0_open_loop",
      "H1_verifier_gated",
      "H2_full_recovery"
    ],
    "seed": 13,
    "max_retries": 3,
    "llm_backend": "one_api",
    "use_llm_for_planners": true,
    "metadata": {
      "purpose": "Rerun gpt-5.5 only after TimeoutError, with hardened client timeout/retry.",
      "data_policy": "clean_eai_raw_resources_only"
    }
  },
  "models": [
    {
      "id": "gpt_5_5",
      "provider": "one_api",
      "model": "gpt-5.5"
    }
  ]
}
