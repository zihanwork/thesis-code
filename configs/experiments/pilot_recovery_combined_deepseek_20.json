{
  "name": "pilot_recovery_combined_deepseek_20",
  "continue_on_error": false,
  "base_experiment": {
    "name": "pilot_recovery_combined_deepseek_20",
    "tasks_path": "data/processed/tasksets/balanced_eval_20.jsonl",
    "failure_memory_path": "data/knowledge/failure_memory_dev.jsonl",
    "output_dir": "runs/pilot_recovery_combined_deepseek_20",
    "planners": ["P0_engineered_prompt"],
    "harness_modes": [
      "H2_combined",
      "H2_combined_no_local",
      "H2_combined_no_error",
      "H2_combined_no_memory"
    ],
    "seed": 13,
    "max_retries": 1,
    "llm_backend": "one_api",
    "use_llm_for_planners": true,
    "llm_temperature": 0.0,
    "llm_max_tokens": 2048,
    "llm_timeout_seconds": 180,
    "llm_max_attempts": 2,
    "llm_backoff_seconds": 2.0,
    "metadata": {
      "phase": "development_pilot",
      "research_question": "Leave-one-component-out recovery ablation",
      "memory_policy": "frozen development memory; symbolic-PDDL teacher; report provenance explicitly",
      "pddl_fallback": "excluded",
      "data_policy": "balanced_eval_20_is_development_only; never use frozen held-out data",
      "budget_policy": "20 tasks; one shared P0 initial plan per task; at most 100 LLM calls; one repair maximum; 2048 output-token cap",
      "run_gate": "Run only if the isolated recovery pilot justifies a combined mechanism comparison."
    }
  },
  "models": [
    {"id": "deepseek_v4_flash", "provider": "one_api", "model": "DeepSeek-V4-Flash"}
  ]
}
