{
  "name": "eai_model_generalization_smoke",
  "continue_on_error": true,
  "base_experiment": {
    "name": "eai_model_generalization_smoke",
    "tasks_path": "data/processed/tasksets/eai_smoke_eval.jsonl",
    "retrieval_examples_path": "data/processed/tasksets/rag_train.jsonl",
    "retrieval_method": "lexical",
    "retrieval_field_profile": "instruction_state_goal_schema",
    "retrieval_top_k": 1,
    "retrieval_min_score": 0.0,
    "output_dir": "runs/eai_model_generalization_smoke",
    "planners": ["P0_engineered_prompt", "P1_rag"],
    "harness_modes": ["H0_open_loop", "H2_llm_reflection"],
    "seed": 13,
    "max_retries": 1,
    "llm_backend": "one_api",
    "use_llm_for_planners": true,
    "llm_max_tokens": 1024,
    "llm_timeout_seconds": 180,
    "llm_max_attempts": 2,
    "llm_backoff_seconds": 2.0,
    "metadata": {
      "phase": "compatibility_smoke",
      "research_question": "RQ4 cross-family generalization",
      "data_policy": "development_only_no_frozen_heldout",
      "budget_policy": "2 evaluation tasks; 32 worst-case calls; 1024 output-token cap; one repair maximum",
      "claim_limit": "Compatibility evidence only; this run is too small for a generalization claim.",
      "promotion_rule": "Promote only models whose full model run succeeds with parseable plans, complete telemetry, and no length-truncated calls after output-budget calibration."
    }
  },
  "models": [
    {"id": "deepseek_v4_flash", "provider": "one_api", "model": "DeepSeek-V4-Flash"},
    {"id": "gpt_5_5", "provider": "one_api", "model": "gpt-5.5"},
    {"id": "deepseek_v4_pro", "provider": "one_api", "model": "DeepSeek-V4-Pro"},
    {"id": "glm_5_turbo", "provider": "one_api", "model": "GLM-5-Turbo"},
    {
      "id": "minimax_m3",
      "provider": "one_api",
      "model": "MiniMax-M3",
      "enabled": false,
      "notes": "Enable only after output-format compatibility is verified."
    },
    {
      "id": "kimi_k2_6",
      "provider": "one_api",
      "model": "Kimi-K2.6",
      "temperature": 1.0,
      "enabled": false,
      "notes": "Current smoke calls returned empty content."
    }
  ]
}
