{
  "name": "eai_model_output_budget_canary",
  "continue_on_error": true,
  "base_experiment": {
    "name": "eai_model_output_budget_canary",
    "tasks_path": "data/processed/tasksets/eai_smoke_eval.jsonl",
    "retrieval_examples_path": "data/processed/tasksets/rag_train.jsonl",
    "output_dir": "runs/eai_model_output_budget_canary",
    "planners": ["P0_engineered_prompt"],
    "harness_modes": ["H0_open_loop"],
    "seed": 13,
    "max_retries": 0,
    "llm_backend": "one_api",
    "use_llm_for_planners": true,
    "llm_max_tokens": 2048,
    "llm_timeout_seconds": 180,
    "llm_max_attempts": 1,
    "llm_backoff_seconds": 2.0,
    "metadata": {
      "phase": "output_budget_canary",
      "data_policy": "development_only_no_frozen_heldout",
      "budget_policy": "2 evaluation tasks; 4 total calls; 2048 output-token cap; no repair calls",
      "research_question": "Can promoted models complete realistic EAI plans without length truncation?",
      "promotion_rule": "Require a successful model run, zero failed calls, zero length-truncated calls, parseable plans, and complete token/latency telemetry."
    }
  },
  "models": [
    {
      "id": "deepseek_v4_pro",
      "provider": "one_api",
      "model": "DeepSeek-V4-Pro"
    },
    {
      "id": "glm_5_turbo",
      "provider": "one_api",
      "model": "GLM-5-Turbo"
    }
  ]
}
