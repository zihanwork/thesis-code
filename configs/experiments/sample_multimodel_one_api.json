{
  "name": "sample_multimodel_one_api",
  "continue_on_error": true,
  "base_experiment": {
    "name": "sample_multimodel_one_api",
    "tasks_path": "data/sample_tasks.jsonl",
    "output_dir": "runs/sample_multimodel_one_api",
    "planners": [
      "P0_prompt_only",
      "P1_retrieval_augmented",
      "P2_graph_grounded"
    ],
    "harness_modes": [
      "H0_open_loop",
      "H1_verifier_gated",
      "H2_full_recovery"
    ],
    "seed": 13,
    "max_retries": 3,
    "llm_backend": "one_api",
    "use_llm_for_planners": true,
    "metadata": {
      "purpose": "Multi-model smoke experiment on the controlled symbolic sample tasks."
    }
  },
  "models": [
    {
      "id": "deepseek_v4_flash",
      "provider": "one_api",
      "model": "DeepSeek-V4-Flash"
    },
    {
      "id": "glm_5",
      "provider": "one_api",
      "model": "GLM-5"
    },
    {
      "id": "gpt_5_5",
      "provider": "one_api",
      "model": "gpt-5.5"
    }
  ]
}
