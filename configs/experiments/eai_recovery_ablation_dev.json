{
  "name": "eai_recovery_ablation_dev",
  "continue_on_error": true,
  "base_experiment": {
    "name": "eai_recovery_ablation_dev",
    "tasks_path": "data/processed/tasksets/balanced_eval.jsonl",
    "retrieval_examples_path": "data/processed/tasksets/rag_train.jsonl",
    "retrieval_method": "lexical",
    "retrieval_field_profile": "instruction_state_goal_schema",
    "retrieval_top_k": 1,
    "retrieval_min_score": 0.0,
    "failure_memory_path": "data/knowledge/failure_memory_dev.jsonl",
    "output_dir": "runs/eai_recovery_ablation_dev",
    "planners": ["P0_engineered_prompt", "P1_rag"],
    "harness_modes": [
      "H0_open_loop",
      "H2_local_recovery",
      "H2_llm_reflection",
      "H2_error_specific",
      "H2_memory",
      "H2_pddl_recovery"
    ],
    "seed": 13,
    "max_retries": 2,
    "llm_backend": "one_api",
    "use_llm_for_planners": true,
    "metadata": {
      "phase": "development",
      "research_question": "RQ2 isolated recovery mechanisms and RQ3 complementarity",
      "data_policy": "balanced_eval_202_is_development_only",
      "legacy_h2_full_recovery": "excluded_due_to_mechanism_overlap"
    }
  },
  "models": [
    {"id": "deepseek_v4_flash", "provider": "one_api", "model": "DeepSeek-V4-Flash"},
    {"id": "gpt_5_5", "provider": "one_api", "model": "gpt-5.5"}
  ]
}
